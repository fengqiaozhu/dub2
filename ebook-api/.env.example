PORT=13000
DATABASE_URL=postgres://ebook:ebook@localhost:5432/ebook

# --- Access control (required) ---
# Fail-closed: empty DUB_ACCESS_TOKEN without DUB_AUTH_MODE=disabled
# makes `npm start` print "Refusing to start" and exit 1.
# Do not put a shared default token here. Generate your own:
#   openssl rand -hex 24
DUB_ACCESS_TOKEN=
# Local trial only. Uncommenting this opens /api/* and /media/* to anyone.
# DUB_AUTH_MODE=disabled

# Browser origin allowed by API CORS (Vite dev server defaults to 13001).
DUB_CORS_ORIGIN=http://localhost:13001

# --- Chapter export ---
# Empty = mp3-192k. wav-legacy restores historical WAV output.
EXPORT_PROFILE=

# --- ffmpeg ---
# Empty = ffmpeg-static, then system PATH. A set-but-unusable path
# fails fast and does not silently fall back.
FFMPEG_PATH=

# S3 / MinIO storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ebook
S3_ACCESS_KEY_ID=ebook
S3_SECRET_ACCESS_KEY=ebook-secret
S3_FORCE_PATH_STYLE=true

# AI Configuration
OPEN_AI_API_KEY=your_openai_api_key_here
OPEN_AI_API_URL=https://api.deepseek.com
OPEN_AI_MODEL=deepseek-v4-pro
OPEN_AI_TIMEOUT=60000

# Mosi Configuration
MOSI_API_KEY=your_mosi_api_key_here
MOSI_BASE_URL=https://studio.mosi.cn

# Fish Audio Configuration
FISH_API_KEY=your_fish_audio_api_key_here
FISH_DEFAULT_MODEL=s2.1-pro
FISH_DEFAULT_FORMAT=mp3
FISH_TIMEOUT_SECONDS=240

# Fish Audio Self-Hosted Configuration
FISH_SELF_HOSTED_BASE_URL=http://localhost:8080
FISH_SELF_HOSTED_DEFAULT_FORMAT=wav
FISH_SELF_HOSTED_TIMEOUT_SECONDS=600
