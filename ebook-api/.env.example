PORT=13000
DB_PATH=database.sqlite

# AI Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT=60000

# Mosi Configuration
MOSI_API_KEY=your_mosi_api_key_here
MOSI_BASE_URL=https://studio.mosi.cn

# Fish Audio Configuration
FISH_API_KEY=your_fish_audio_api_key_here
FISH_DEFAULT_MODEL=s2-pro
FISH_DEFAULT_FORMAT=mp3
FISH_TIMEOUT_SECONDS=240

# Fish Audio Self-Hosted Configuration
FISH_SELF_HOSTED_BASE_URL=http://localhost:8080
FISH_SELF_HOSTED_DEFAULT_FORMAT=wav
FISH_SELF_HOSTED_TIMEOUT_SECONDS=600
