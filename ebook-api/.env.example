PORT=13000
DATABASE_URL=postgres://ebook:ebook@localhost:5432/ebook

# S3 / MinIO storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ebook
S3_ACCESS_KEY_ID=ebook
S3_SECRET_ACCESS_KEY=ebook-secret
S3_FORCE_PATH_STYLE=true

# AI Configuration
OPEN_AI_API_KEY=your_openai_api_key_here
OPEN_AI_API_URL=https://api.deepseek.com
OPEN_AI_MODEL=deepseek-v4-pro
OPEN_AI_TIMEOUT=60000

# Mosi Configuration
MOSI_API_KEY=your_mosi_api_key_here
MOSI_BASE_URL=https://studio.mosi.cn

# Fish Audio Configuration
FISH_API_KEY=your_fish_audio_api_key_here
FISH_DEFAULT_MODEL=s2.1-pro
FISH_DEFAULT_FORMAT=mp3
FISH_TIMEOUT_SECONDS=240

# Fish Audio Self-Hosted Configuration
FISH_SELF_HOSTED_BASE_URL=http://localhost:8080
FISH_SELF_HOSTED_DEFAULT_FORMAT=wav
FISH_SELF_HOSTED_TIMEOUT_SECONDS=600
