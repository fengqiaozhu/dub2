# Copy to .env in the repository root before `docker compose up`.
# Compose interpolates this file and passes the values below into the API container.
# Do not commit a real .env.

# --- Access control (required) ---
# Fail-closed: if DUB_ACCESS_TOKEN is empty AND DUB_AUTH_MODE is not exactly
# "disabled", the API refuses to start. There is no default token and no
# silent fallback to open access.
#
# Option A (recommended): set a private shared secret.
DUB_ACCESS_TOKEN=
# Option B (local trial only): uncomment to run without authentication.
# DUB_AUTH_MODE=disabled

# Browser origin allowed by API CORS. Docker UI defaults to this value.
DUB_CORS_ORIGIN=http://localhost:13001

# --- Chapter export ---
# Empty = mp3-192k (CBR 192 kbps / 44.1 kHz / stereo).
# wav-legacy = historical pcm_s16le WAV, no loudness normalization.
EXPORT_PROFILE=

# --- ffmpeg ---
# Empty = resolve ffmpeg-static, then system PATH.
# If this is set to a missing or non-executable path, export fails fast
# and does not fall back to another binary.
FFMPEG_PATH=

# --- Optional provider keys (can also be added later in 系统设置) ---
OPEN_AI_API_KEY=
OPEN_AI_API_URL=https://api.deepseek.com
OPEN_AI_MODEL=deepseek-v4-pro
MOSI_API_KEY=
MOSI_BASE_URL=https://studio.mosi.cn
FISH_API_KEY=
FISH_DEFAULT_MODEL=
FISH_SELF_HOSTED_BASE_URL=
