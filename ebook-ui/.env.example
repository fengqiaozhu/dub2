# Optional local Vite fallback only. The running UI prefers the value
# saved in 系统设置 → 访问令牌 (localStorage key dub_access_token).
# Docker images do not bake this variable; enter the token in the UI
# after start. Do not commit a real token.
VITE_DUB_ACCESS_TOKEN=

# Override media origin if the UI is not same-origin with the API.
# VITE_MEDIA_BASE_URL=http://localhost:13000
